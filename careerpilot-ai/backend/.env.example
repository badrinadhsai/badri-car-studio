# Copy to .env (same directory) and fill in real values. Never commit real keys.
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Server-side LLM provider (OpenAI-compatible chat-completions API).
# Example:
#   LLM_API_KEY=your_server_side_key_here
#   LLM_BASE_URL=https://provider.example/v1
#   LLM_MODEL=your-model-name
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional request timeout in ms (defaults: 90000 full analysis, 60000 modular calls).
# LLM_TIMEOUT_MS=

# Supabase authentication (server-side verification of frontend sessions).
# Get these from: Supabase Dashboard → Project Settings → API.
# The anon key here is only used to VERIFY user JWTs — never sent to clients.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Only needed for future server-side admin tasks (e.g. account
# deletion). NEVER prefix with VITE_, NEVER expose to the frontend.
# SUPABASE_SERVICE_ROLE_KEY=
