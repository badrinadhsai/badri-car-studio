# Copy backend/.env.example to backend/.env (never commit real keys).
# Copy frontend/.env.example to frontend/.env (public Supabase values only).
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Server-side LLM provider — OpenAI-compatible chat-completions API.
# The frontend never sees these values. Configure them only in backend/.env.
# Current production model: gemini-3.5-flash-lite (do not change).
# Example:
#   LLM_API_KEY=your_server_side_key_here
#   LLM_BASE_URL=https://provider.example/v1
#   LLM_MODEL=your-model-name
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional request timeout in ms (defaults: 90000 full analysis, 60000 modular calls).
# LLM_TIMEOUT_MS=

# Backend Supabase verification (backend/.env only — never VITE_ prefixed):
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend Supabase client (frontend/.env only — public values):
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# NEVER put SUPABASE_SERVICE_ROLE_KEY or LLM_API_KEY in frontend/.env.
